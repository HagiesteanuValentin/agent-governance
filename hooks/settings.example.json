{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-start.sh",
            "statusMessage": "Reading HANDOFF.md"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/read-mare.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/brief-mare.sh"
          }
        ]
      },
      {
        "_note": "implementer*/scripter* sub-agents only: warns once at 150000 tokens of context, denies every tool except Bash at 220000",
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/context-agent.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "_note": "main and every sub-agent: non-blocking signal when an Edit/Write adds a comment block of 2+ lines, a comment line over 160 chars, or over 25% comments in the added lines; logs to /tmp/claude-hooks/comentarii-<session>.jsonl",
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/comentarii-cod.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/raport-lung.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-metrics.sh"
          }
        ]
      }
    ]
  }
}
